# 1. Copy this file to secrets.toml in the same folder (.streamlit/secrets.toml)
# 2. Replace the placeholder with your own Google Gemini API key (from https://aistudio.google.com/apikey)
# 3. Never share or commit secrets.toml
GEMINI_API_KEY = "paste-your-key-here"

# Optional: change the judge model (default is gemini-2.5-pro).
# GEMINI_MODEL = "gemini-2.5-flash"
